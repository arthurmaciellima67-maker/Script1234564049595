local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "FormigaGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local botao = Instance.new("TextButton")
botao.Size = UDim2.fromOffset(130, 45)
botao.Position = UDim2.new(0.1, 0, 0.5, 0)
botao.Text = "FORMIGA: OFF"
botao.TextScaled = true
botao.Active = true
botao.Draggable = true
botao.Parent = gui

local ativo = false

local function aplicar()
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    humanoid.DisplayDistanceType =
        Enum.HumanoidDisplayDistanceType.None

    local escalas = {
        "BodyHeightScale",
        "BodyWidthScale",
        "BodyDepthScale",
        "HeadScale"
    }

    for _, nome in ipairs(escalas) do
        local escala = humanoid:FindFirstChild(nome)
        if escala and escala:IsA("NumberValue") then
            escala.Value = ativo and 0.1 or 1
        end
    end
end

botao.Activated:Connect(function()
    ativo = not ativo
    botao.Text = ativo and "FORMIGA: ON" or "FORMIGA: OFF"
    aplicar()
end)

player.CharacterAdded:Connect(function()
    task.wait(1)
    aplicar()
end)

aplicar()
