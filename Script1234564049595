local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function aplicarFormiga(ativo)
    local char = player.Character
    if not char then
        warn("Personagem ainda não carregou")
        return
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        warn("Humanoid não encontrado")
        return
    end

    print("Tipo de personagem:", humanoid.RigType.Name)

    humanoid.DisplayDistanceType =
        Enum.HumanoidDisplayDistanceType.None

    local nomes = {
        "BodyHeightScale",
        "BodyWidthScale",
        "BodyDepthScale",
        "HeadScale"
    }

    local encontrados = 0

    for _, nome in ipairs(nomes) do
        local escala = humanoid:FindFirstChild(nome)

        if escala and escala:IsA("NumberValue") then
            escala.Value = ativo and 0.1 or 1
            encontrados += 1
        end
    end

    print("Valores de escala encontrados:", encontrados)

    if encontrados == 0 then
        warn("Este personagem não tem valores de escala compatíveis.")
    end
end

-- Teste manual:
aplicarFormiga(true)
